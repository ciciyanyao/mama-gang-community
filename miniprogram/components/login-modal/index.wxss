/* components/login-modal/index.wxss —— 登录弹窗（底部滑出 + 液态玻璃质感） */
.login-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(20, 30, 25, 0.04); /* 遮罩朦胧同步降低 90%：0.35→0.04，sheet 清晰凸显 */
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

/* 玻璃质感 Sheet（朦胧效果降低 90%，文字清晰优先）：
   - 不透明度 0.97（保留约 10% 玻璃通透感，背景基本不可见，文字清晰可辨）
   - backdrop-filter 模糊 4rpx（原 40rpx 的 10%）、饱和度 108%（原 180% 的约 10% 增益）
   - 顶部高光边保留玻璃边缘质感
   - bottom 内边距 = 安全区 + tab 栏高度(100rpx) + "+"凸起(32rpx)，确保"完成登录"按钮位于 tab 栏之上，与"+"无重叠 */
.login-sheet {
  position: relative;
  width: 100%;
  background: rgba(255, 255, 255, 0.97);
  backdrop-filter: blur(4rpx) saturate(108%);
  -webkit-backdrop-filter: blur(4rpx) saturate(108%);
  border-radius: 32rpx 32rpx 0 0;
  padding: 20rpx 40rpx calc(40rpx + 132rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.12);
  overflow: hidden;
}
/* 顶部玻璃高光边 */
.login-sheet::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2rpx;
  background: linear-gradient(90deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0.9) 50%, rgba(255,255,255,0) 100%);
}

.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: rgba(225, 230, 227, 0.8);
  margin: 0 auto 24rpx;
}

.sheet-title {
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #1F2933;
}

.sheet-sub {
  margin-top: 10rpx;
  text-align: center;
  font-size: 24rpx;
  color: #7A7A7A;
}

.avatar-picker-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 28rpx 0;
}
.avatar-picker {
  width: 160rpx;
  height: 160rpx;
  padding: 0;
  border-radius: 50%;
  background: rgba(242, 246, 244, 0.7);
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1.2;
  font-size: 24rpx;
  color: #2E7D5B;
  border: 2rpx dashed rgba(168, 203, 185, 0.9);
}
.avatar-picker::after {
  border: none;
}
.avatar-preview {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
}
.avatar-picker-text {
  padding: 0 16rpx;
  text-align: center;
}

.nickname-input {
  background: rgba(247, 249, 248, 0.75);
  border: 1rpx solid rgba(225, 230, 227, 0.6);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #1F2933;
  margin-bottom: 24rpx;
}

.gender-picker {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}
.gender-label {
  font-size: 28rpx;
  color: #1F2933;
  margin-right: 32rpx;
}
.gender-option {
  display: inline-flex;
  align-items: center;
  margin-right: 40rpx;
  font-size: 28rpx;
  color: #3E4C59;
}

/* 主按钮：实色绿，确保在玻璃 sheet 上对比清晰、与下方"+"圆形按钮形成层次区分 */
.save-btn {
  background: #2E7D5B;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 20rpx rgba(46, 125, 91, 0.3);
}
.save-btn::after {
  border: none;
}

.sheet-tip {
  margin-top: 16rpx;
  text-align: center;
  font-size: 22rpx;
  color: #9AA5B1;
}
