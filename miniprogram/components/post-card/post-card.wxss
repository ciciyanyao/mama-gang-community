/* components/post-card/post-card.wxss —— 帖子卡片样式 */
.post-card {
  position: relative;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx 24rpx 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04), 0 12rpx 32rpx rgba(0, 0, 0, 0.05);
  transition: opacity 0.15s ease;
}

/* iOS 按压反馈：整卡轻微透明 */
.post-card-hover {
  opacity: 0.8;
}

/* 置顶标识 */
.pin-badge {
  position: absolute;
  top: 0;
  right: 24rpx;
  background: #E5484D;
  color: #FFFFFF;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 0 0 8rpx 8rpx;
  font-weight: 500;
}

/* 作者信息行 */
.post-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.post-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #E9E2D4;
  flex-shrink: 0;
}

.post-author-info {
  flex: 1;
  margin-left: 16rpx;
  overflow: hidden;
}

.post-author-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #2E3A33;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.anon-tag {
  display: inline-block;
  font-size: 20rpx;
  color: #8B958C;
  background: #E9E2D4;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  font-weight: 400;
}

.post-time {
  font-size: 24rpx;
  color: #8B958C;
  margin-top: 4rpx;
}

.post-category-tag {
  font-size: 22rpx;
  color: #3A7A5C;
  background: rgba(58, 122, 92, 0.08);
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
}

/* 正文区域 */
.post-content {
  margin-bottom: 16rpx;
}

.post-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #2E3A33;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.post-summary {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
  font-size: 28rpx;
  color: #7C887E;
  line-height: 1.6;
}

/* 图片区域 */
.post-images {
  display: flex;
  gap: 8rpx;
  margin-bottom: 16rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.post-image {
  border-radius: 8rpx;
  background: #E9E2D4;
}

.post-images-1 .post-image {
  width: 100%;
  height: 360rpx;
}

.post-images-2 .post-image {
  width: calc(50% - 4rpx);
  height: 240rpx;
}

.post-images-3 .post-image {
  width: calc(33.33% - 6rpx);
  height: 200rpx;
}

/* 底部操作栏：点赞 / 评论 / 收藏 */
.post-actions {
  display: flex;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #E9E2D4;
}

.action-item {
  display: flex;
  align-items: center;
  margin-right: 48rpx;
  padding: 8rpx 0;
}

.action-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 10rpx;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
  transition: transform 0.15s ease;
}

.action-item:active .action-icon {
  transform: scale(0.85);
}

