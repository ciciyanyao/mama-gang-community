.post-card {
  position: relative;
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.top-tag {
  position: absolute;
  top: 0;
  left: 0;
  background: linear-gradient(135deg, #ff6b6b, #ff8e8e);
  padding: 8rpx 24rpx;
  border-radius: 0 0 16rpx 0;
  z-index: 10;
}

.top-text {
  font-size: 22rpx;
  color: #fff;
  font-weight: bold;
}

.post-content {
  padding: 24rpx;
}

.post-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  background: #f0f0f0;
}

.user-info {
  flex: 1;
}

.nickname {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.time {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.category-tag {
  background: #e8f5e9;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
}

.category-text {
  font-size: 22rpx;
  color: #2E7D5B;
}

.post-body {
  margin-bottom: 20rpx;
}

.title {
  display: block;
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.summary {
  display: block;
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

.post-images {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 20rpx;
  gap: 12rpx;
}

.post-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 8rpx;
  background: #f0f0f0;
}

.post-image.single {
  width: 400rpx;
  height: 300rpx;
}

.post-stats {
  display: flex;
  gap: 40rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f5f5f5;
}

.stat-item {
  display: flex;
  align-items: center;
}

.stat-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 8rpx;
}

.stat-num {
  font-size: 24rpx;
  color: #999;
}