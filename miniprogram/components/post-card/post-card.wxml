<view class="post-card" bindtap="onTap">
  <!-- 置顶标识 -->
  <view class="top-tag" wx:if="{{showTopTag && post.is_top}}">
    <text class="top-text">置顶</text>
  </view>

  <view class="post-content">
    <!-- 用户信息 -->
    <view class="post-header">
      <image class="avatar" src="{{post.avatar || '/images/user-3-line.svg'}}" mode="aspectFill" />
      <view class="user-info">
        <text class="nickname">{{post.nickname || '匿名用户'}}</text>
        <text class="time">{{timeText}}</text>
      </view>
      <view class="category-tag" wx:if="{{post.category}}">
        <text class="category-text">{{post.category}}</text>
      </view>
    </view>

    <!-- 帖子内容 -->
    <view class="post-body">
      <text class="title" wx:if="{{post.title}}">{{post.title}}</text>
      <text class="summary">{{post.content}}</text>
    </view>

    <!-- 图片展示 -->
    <view class="post-images" wx:if="{{post.images && post.images.length > 0}}">
      <image
        class="post-image {{post.images.length === 1 ? 'single' : ''}}"
        wx:for="{{post.images}}"
        wx:key="*this"
        src="{{item}}"
        mode="aspectFill"
        lazy-load
      />
    </view>

    <!-- 统计信息 -->
    <view class="post-stats">
      <view class="stat-item" catchtap="onLikeTap">
        <image class="stat-icon" src="/images/like-line.svg" />
        <text class="stat-num">{{post.likeCount || 0}}</text>
      </view>
      <view class="stat-item">
        <image class="stat-icon" src="/images/comment-line.svg" />
        <text class="stat-num">{{post.commentCount || 0}}</text>
      </view>
    </view>
  </view>
</view>