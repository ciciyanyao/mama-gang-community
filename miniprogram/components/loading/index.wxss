/* components/loading/index.wxss —— DailyBean 风格：干净简洁 */
/* 参考图：暖米背景 + 绿色圆形 blob + 斜条纹进度条 + 双行文案 */

/* 外层：全屏居中 + 暖米背景 */
.loading-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
  box-sizing: border-box;
  animation: fadeIn 0.35s ease;
}
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(16rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ========== 绿色圆形 blob ========== */
.blob-wrap {
  margin-bottom: 40rpx;
}
.blob {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 32rpx rgba(46, 125, 91, 0.22);
}
/* loading 态：主色绿 + 呼吸缩放 */
.blob-loading {
  background: #2E7D5B;
  animation: blobBreathe 1.6s ease-in-out infinite;
}
@keyframes blobBreathe {
  0%, 100% { transform: scale(1); box-shadow: 0 12rpx 32rpx rgba(46, 125, 91, 0.22); }
  50%      { transform: scale(1.08); box-shadow: 0 16rpx 40rpx rgba(46, 125, 91, 0.3); }
}
/* success：主色绿底 + 白勾 */
.blob-success {
  background: #2E7D5B;
  animation: blobPop 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
}
@keyframes blobPop {
  0%   { transform: scale(0.6); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}
/* error：白底红叉 */
.blob-error {
  background: #FFFFFF;
  border: 4rpx solid #E54848;
  animation: blobPop 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
}

/* 白勾 */
.check-mark {
  width: 56rpx;
  height: 34rpx;
  border-left: 6rpx solid #FFFFFF;
  border-bottom: 6rpx solid #FFFFFF;
  transform: rotate(-45deg) translate(6rpx, -6rpx);
}

/* 红叉 */
.cross-line {
  position: absolute;
  width: 64rpx;
  height: 6rpx;
  background: #E54848;
  border-radius: 3rpx;
  left: 50%;
  top: 50%;
}
.cross-l1 { transform: translate(-50%, -50%) rotate(45deg); }
.cross-l2 { transform: translate(-50%, -50%) rotate(-45deg); }

/* ========== 主标题 ========== */
.title {
  font-size: 48rpx;
  font-weight: 700;
  color: #2E7D5B;
  letter-spacing: 2rpx;
  margin-bottom: 40rpx;
}

/* ========== 斜条纹进度条 ========== */
.stripe-bar {
  width: 100%;
  max-width: 560rpx;
  height: 24rpx;
  background: #E8EEE9;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: inset 0 2rpx 4rpx rgba(0, 0, 0, 0.06);
}
.stripe-fill {
  height: 100%;
  background: #2E7D5B;
  border-radius: 12rpx;
  transition: width 0.4s ease;
  position: relative;
  overflow: hidden;
}
/* DailyBean 风格 45° 斜条纹 */
.stripe-pattern {
  position: absolute;
  inset: 0;
  background: repeating-linear-gradient(
    45deg,
    transparent,
    transparent 14rpx,
    rgba(255, 255, 255, 0.28) 14rpx,
    rgba(255, 255, 255, 0.28) 28rpx
  );
  animation: stripeFlow 1.8s linear infinite;
}
@keyframes stripeFlow {
  from { background-position: 0 0; }
  to   { background-position: 56rpx 0; }
}

/* ========== 副标题 / 百分比 ========== */
.subtitle-row {
  margin-top: 36rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.subtitle {
  font-size: 28rpx;
  color: #7A7A7A;
}
.pct {
  font-size: 26rpx;
  color: #2E7D5B;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

/* ========== 重试按钮 ========== */
.retry-btn {
  margin-top: 36rpx;
  padding: 18rpx 56rpx;
  font-size: 28rpx;
  color: #FFFFFF;
  background: #2E7D5B;
  border-radius: 40rpx;
  box-shadow: 0 6rpx 16rpx rgba(46, 125, 91, 0.25);
  transition: opacity 0.2s ease;
}
.retry-btn:active { opacity: 0.75; }
