/* subpkg/chat/chat.wxss —— 私信对话页 */
.chat-page {
  min-height: 100vh;
  background: #F8F3E8;
  display: flex;
  flex-direction: column;
}

.msg-area {
  flex: 1;
  padding: 24rpx 24rpx 32rpx;
  overflow-y: auto;
}

/* 气泡行 */
.bubble-row {
  display: flex;
  flex-direction: column;
  margin-bottom: 24rpx;
}

.bubble-row.peer {
  align-items: flex-start;
}

.bubble-row.self {
  align-items: flex-end;
}

.bubble {
  max-width: 70%;
  padding: 20rpx 28rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  line-height: 1.5;
  word-break: break-all;
}

.bubble-row.peer .bubble {
  background: #FFFFFF;
  color: #2E3A33;
  border-top-left-radius: 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(46, 58, 51, 0.06);
}

.bubble-row.self .bubble {
  background: #3A7A5C;
  color: #FFFFFF;
  border-top-right-radius: 8rpx;
}

.bubble-time {
  font-size: 20rpx;
  color: #8B958C;
  margin-top: 8rpx;
  padding: 0 8rpx;
}

/* 底部输入栏 */
.input-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 1rpx solid #E9E2D4;
}

.chat-input {
  flex: 1;
  height: 76rpx;
  background: #F8F3E8;
  border-radius: 38rpx;
  padding: 0 32rpx;
  font-size: 28rpx;
  color: #2E3A33;
}

.send-btn {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 14rpx 36rpx;
  border-radius: 38rpx;
  font-size: 28rpx;
  color: #FFFFFF;
  background: #C9D6CD;
  font-weight: 600;
}

.send-btn.active {
  background: #3A7A5C;
}

.send-btn:active {
  opacity: 0.8;
}
