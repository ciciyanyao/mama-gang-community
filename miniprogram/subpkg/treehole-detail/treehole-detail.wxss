/* subpkg/treehole-detail/treehole-detail.wxss —— 树洞详情（背景图卡片，与树洞主页同款） */
.page-wrap {
  min-height: 100vh;
  background-color: #F8F3E8;
  padding: 24rpx;
  box-sizing: border-box;
}

/* ========== 加载占位 ========== */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}
.loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 6rpx solid #CBE4D3;
  border-top-color: #3A7A5C;
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}
.loading-text {
  margin-top: 24rpx;
  color: #7C887E;
  font-size: 26rpx;
}

/* ========== 背景图卡片（与主页 post-card 一致，高度由内容撑开） ========== */
.post-card {
  position: relative;
  width: 100%;
  min-height: 900rpx; /* 文字少时保持卡片图自然高度 */
  border-radius: 20rpx;
  overflow: hidden;
}

/* 背景图：绝对定位铺满整个卡片（含被文字撑高的部分） */
.card-bg-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

/* 内容覆盖在卡片上（参与撑高卡片） */
.card-content {
  position: relative;
  z-index: 2;
  width: 100%;
  min-height: 900rpx;
  /* 内边距避开图片边缘图案 */
  padding: 130rpx 100rpx 120rpx 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.deco {
  position: absolute;
  font-size: 40rpx;
  z-index: 5;
}
.deco-top-left { top: 10rpx; left: 10rpx; }
.deco-bottom-right { bottom: 10rpx; right: 10rpx; }

/* 右上角"···"：实底白底 + 深绿三点，清晰可见（不用半透明） */
.more-btn {
  position: absolute;
  top: 24rpx;
  right: 28rpx;
  z-index: 9;
  font-size: 30rpx;
  font-weight: 700;
  color: #2B5C45;
  padding: 14rpx 24rpx;
  line-height: 1;
  border-radius: 16rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(43, 92, 69, 0.18);
}
.more-btn:active {
  background: #F1EFE6;
}

.post-header {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  margin-bottom: 20rpx;
}
.avatar {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
  display: block;
}
.user-info {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.user-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #2B5C45;
}
.post-time {
  font-size: 24rpx;
  color: #7C887E;
  margin-top: 4rpx;
}

.post-content {
  font-size: 30rpx;
  color: #2B5C45;
  line-height: 1.6;
  margin-bottom: 20rpx;
  font-weight: 500;
  word-break: break-all;
  text-align: center;
  width: 100%;
  white-space: pre-wrap;
  max-height: 420rpx;
  overflow-y: auto;
}

.post-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  border-top: 3rpx dashed #B8DCC4;
  padding-top: 20rpx;
}
.hug-count {
  font-size: 24rpx;
  color: #7C887E;
  font-weight: bold;
}
.hug-btn {
  background-color: #3A7A5C;
  color: #FFFFFF;
  font-size: 24rpx;
  padding: 10rpx 24rpx;
  border-radius: 255px 15px 225px 15px / 15px 225px 15px 255px;
  border: 4rpx solid #B8DCC4;
  box-shadow: 3rpx 3rpx 0 #B8DCC4;
  font-weight: bold;
}

/* ========== 不存在 ========== */
.not-found {
  padding: 200rpx 0;
  text-align: center;
  color: #A8B2AC;
  font-size: 26rpx;
}
