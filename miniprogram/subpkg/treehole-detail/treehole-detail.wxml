<!-- subpkg/treehole-detail/treehole-detail.wxml —— 树洞帖详情页（背景图卡片 + 右上角"···"删除） -->
<view class="page-wrap">

  <!-- 加载占位 -->
  <view class="loading-wrap" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 树洞卡片（与树洞主页同款背景图卡片） -->
  <view class="post-card" wx:if="{{post && !loading}}">
    <!-- 卡片背景图：铺满卡片（卡片高度由文字撑开，文字多自动拉长） -->
    <image class="card-bg-img" src="{{bgImage}}" mode="aspectFill"></image>

    <!-- 随机装饰 -->
    <view class="deco deco-top-left">{{deco1}}</view>
    <view class="deco deco-bottom-right">{{deco2}}</view>

    <!-- 右上角"···"：仅本人可见 → 删除 -->
    <view class="more-btn" wx:if="{{isOwner}}" bindtap="onMoreTap">···</view>

    <!-- 文字内容：绝对居中 -->
    <view class="card-content">
      <view class="post-header">
        <image class="avatar" src="/images/anonymous/anon-7-treehole.png" mode="aspectFill"></image>
        <view class="user-info">
          <view class="user-name">{{post.nickname}}</view>
          <view class="post-time">{{post.timeText}}</view>
        </view>
      </view>

      <view class="post-content">{{post.content}}</view>

      <view class="post-footer">
        <view class="hug-count">已有 {{post.hugCount}} 位妈妈抱过你</view>
        <view class="hug-btn hugged">已抱抱</view>
      </view>
    </view>
  </view>

  <view class="not-found" wx:if="{{!loading && !post}}">
    <text>这条树洞帖不存在或已删除</text>
  </view>

</view>
