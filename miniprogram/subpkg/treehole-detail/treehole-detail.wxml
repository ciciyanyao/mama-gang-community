<!-- subpkg/treehole-detail/treehole-detail.wxml —— 树洞帖详情页（匿名卡片 + 右上角"···"删除） -->
<view class="page-wrap">

  <!-- 加载占位 -->
  <view class="loading-wrap" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 树洞内容 -->
  <view class="tree-card" wx:if="{{post && !loading}}">
    <view class="card-head">
      <view class="head-left">
        <text class="anon-tag">匿名树洞</text>
        <text class="card-time">{{post.timeText}}</text>
      </view>
      <!-- 右上角"···"：仅本人可见 → 删除 -->
      <view class="more-btn" wx:if="{{isOwner}}" bindtap="onMoreTap">···</view>
    </view>

    <text class="card-content">{{post.content}}</text>

    <view class="card-footer">
      <view class="hug-item">🤗 抱抱 {{post.hugCount}}</view>
      <text class="hint-text">这里没人认识你，只属于你的树洞</text>
    </view>
  </view>

  <view class="not-found" wx:if="{{!loading && !post}}">
    <text>这条树洞帖不存在或已删除</text>
  </view>

</view>
