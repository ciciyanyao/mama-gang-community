.container {
  min-height: 100vh;
  background: #F8F3E8;
  padding: 20rpx;
}

.section {
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
}

.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1rpx solid #E9E2D4;
  transition: opacity 0.15s ease;
}

/* iOS 按压反馈 */
.setting-item-hover {
  opacity: 0.75;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-info {
  flex: 1;
}

.setting-label {
  display: block;
  font-size: 30rpx;
  color: #2E3A33;
  margin-bottom: 8rpx;
}

.setting-desc {
  display: block;
  font-size: 24rpx;
  color: #8B958C;
}

/* 退出登录（警示红） */
.logout-label {
  color: #E54848;
}

.arrow-icon {
  width: 32rpx;
  height: 32rpx;
}

.version-info {
  text-align: center;
  padding: 60rpx 0;
}

.version-text {
  font-size: 24rpx;
  color: #8B958C;
}