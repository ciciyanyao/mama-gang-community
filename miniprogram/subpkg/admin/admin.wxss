/* pages/admin/admin.wxss —— 管理后台样式 */

.page-wrap {
  min-height: 100vh;
  background: #F8F3E8;
}

/* ==================== Tab 栏 ==================== */
.tab-bar {
  display: flex;
  background: #FFFFFF;
  border-bottom: 1rpx solid #F1EBDE;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx 0;
  position: relative;
}

.tab-item.active .tab-text {
  color: #3A7A5C;
  font-weight: 600;
}

.tab-text {
  font-size: 30rpx;
  color: #7C887E;
}

.tab-indicator {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: #3A7A5C;
}

.tab-badge {
  position: absolute;
  top: 16rpx;
  right: 20%;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 10rpx;
  border-radius: 20rpx;
  background: #E5484D;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-badge-text {
  font-size: 18rpx;
  color: #FFFFFF;
  line-height: 1;
}

/* ==================== 数据统计 ==================== */
.stats-section {
  padding: 24rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.stat-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 32rpx 24rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04), 0 12rpx 32rpx rgba(0, 0, 0, 0.05);
}

.stat-card.highlight {
  background: linear-gradient(135deg, #3A7A5C 0%, #5A987B 100%);
}

.stat-card.highlight .stat-num,
.stat-card.highlight .stat-label {
  color: #FFFFFF;
}

.stat-num {
  display: block;
  font-size: 56rpx;
  font-weight: bold;
  color: #3A7A5C;
  margin-bottom: 8rpx;
}

.stat-label {
  display: block;
  font-size: 24rpx;
  color: #8B958C;
}

/* ==================== 举报列表 ==================== */
.reports-section {
  padding: 20rpx 24rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0 0;
}

.empty-icon-wrap {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: rgba(58, 122, 92, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.empty-emoji {
  font-size: 72rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #8B958C;
  margin-bottom: 8rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #8B958C;
}

/* 举报列表 */
.report-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.report-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04), 0 12rpx 32rpx rgba(0, 0, 0, 0.05);
}

.report-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.report-tags {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
}

.type-tag {
  flex-shrink: 0;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
}

.type-post {
  background: rgba(58, 122, 92, 0.1);
}

.type-comment {
  background: rgba(255, 152, 0, 0.1);
}

.type-tag-text {
  font-size: 22rpx;
  color: #3A7A5C;
}

.type-comment .type-tag-text {
  color: #D9A576;
}

.report-reason {
  font-size: 26rpx;
  color: #7C887E;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.report-time {
  font-size: 22rpx;
  color: #8B958C;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.report-content {
  margin-bottom: 20rpx;
  padding: 16rpx 20rpx;
  background: #F8F3E8;
  border-radius: 12rpx;
}

.content-text {
  font-size: 26rpx;
  color: #7C887E;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  line-height: 1.6;
}

.content-text.deleted {
  color: #8B958C;
  font-style: italic;
}

/* 操作按钮 */
.report-actions {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  padding: 18rpx 0;
  border-radius: 12rpx;
  text-align: center;
}

.btn-approve {
  background: #E5484D;
}

.btn-reject {
  background: #F1EBDE;
}

.btn-approve .btn-text {
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 500;
}

.btn-reject .btn-text {
  color: #7C887E;
  font-size: 26rpx;
}

/* ==================== 加载状态 ==================== */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #E9E2D4;
  border-top: 4rpx solid #3A7A5C;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 16rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 24rpx;
  color: #8B958C;
}

/* ==================== 没有更多 ==================== */
.no-more {
  text-align: center;
  padding: 32rpx 0;
}

.no-more-text {
  font-size: 24rpx;
  color: #8B958C;
}