.container {
  min-height: 100vh;
  background: #F7F3EA;
  padding: 40rpx;
}

/* Logo区域 */
.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 24rpx;
}

.app-name {
  font-size: 40rpx;
  font-weight: bold;
  color: #2E7D5B;
  margin-bottom: 12rpx;
}

.version {
  font-size: 24rpx;
  color: #999;
}

/* 区块 */
.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.description {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.desc-detail {
  display: block;
  font-size: 26rpx;
  color: #999;
  line-height: 1.6;
}

/* 团队列表 */
.team-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.team-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.team-item:last-child {
  border-bottom: none;
}

.member-name {
  font-size: 28rpx;
  color: #333;
}

.member-role {
  font-size: 24rpx;
  color: #999;
}

/* 技术栈 */
.tech-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tech-item {
  background: #e8f5e9;
  color: #2E7D5B;
  padding: 12rpx 24rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
}

/* 链接 */
.link-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
}

.link-text {
  font-size: 28rpx;
  color: #2E7D5B;
}

.arrow-icon {
  width: 32rpx;
  height: 32rpx;
}

/* 版权信息 */
.copyright {
  text-align: center;
  padding: 40rpx 0;
}

.copyright-text {
  font-size: 22rpx;
  color: #ccc;
}