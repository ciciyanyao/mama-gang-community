.container {
  min-height: 100vh;
  background: #F8F3E8;
  padding: 40rpx;
}

/* Logo区域 */
.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 24rpx;
}

.app-name {
  font-size: 40rpx;
  font-weight: bold;
  color: #3A7A5C;
  margin-bottom: 12rpx;
}

.version {
  font-size: 24rpx;
  color: #8B958C;
}

/* 区块 */
.section {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #2E3A33;
  margin-bottom: 20rpx;
}

.description {
  display: block;
  font-size: 28rpx;
  color: #7C887E;
  margin-bottom: 16rpx;
}

.desc-detail {
  display: block;
  font-size: 26rpx;
  color: #8B958C;
  line-height: 1.6;
}

/* 团队列表 */
.team-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.team-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #E9E2D4;
}

.team-item:last-child {
  border-bottom: none;
}

.member-name {
  font-size: 28rpx;
  color: #2E3A33;
}

.member-role {
  font-size: 24rpx;
  color: #8B958C;
}

/* 技术栈 */
.tech-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tech-item {
  background: #E3EFE7;
  color: #3A7A5C;
  padding: 12rpx 24rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
}

/* 链接 */
.link-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
}

.link-text {
  font-size: 28rpx;
  color: #3A7A5C;
}

.arrow-icon {
  width: 32rpx;
  height: 32rpx;
}

/* 版权信息 */
.copyright {
  text-align: center;
  padding: 40rpx 0;
}

.copyright-text {
  font-size: 22rpx;
  color: #8B958C;
}