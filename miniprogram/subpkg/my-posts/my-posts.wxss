/* pages/my-posts/my-posts.wxss */

.page-wrap {
  min-height: 100vh;
  background: #F8F3E8;
  padding-bottom: 40rpx;
}

/* ==================== 空状态 ==================== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0 0;
}

.empty-icon-wrap {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: rgba(58, 122, 92, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.empty-emoji {
  font-size: 72rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #8B958C;
  margin-bottom: 8rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #8B958C;
}

/* ==================== 帖子列表 ==================== */
.post-list {
  padding: 20rpx 24rpx;
}

.post-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04), 0 12rpx 32rpx rgba(0, 0, 0, 0.05);
}

/* 已删除帖子：半透明 + 灰底（PR#7 样式优化） */
.post-card.post-deleted {
  opacity: 0.6;
  background: #E9E2D4;
}

.post-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.status-tag {
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.status-normal {
  background: rgba(58, 122, 92, 0.1);
  color: #3A7A5C;
}

.status-deleted {
  background: rgba(229, 72, 77, 0.1);
  color: #E5484D;
}

.status-text {
  font-size: 22rpx;
}

.post-time {
  font-size: 22rpx;
  color: #8B958C;
}

.post-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #2E3A33;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.post-content {
  display: block;
  font-size: 26rpx;
  color: #7C887E;
  line-height: 1.6;
  margin-bottom: 16rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.post-stats {
  display: flex;
  align-items: center;
  gap: 24rpx;
  flex: 1;
}

.stat {
  font-size: 22rpx;
  color: #8B958C;
}

.stat.category {
  background: rgba(58, 122, 92, 0.08);
  color: #3A7A5C;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
}

/* 删除按钮 */
.post-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.delete-btn {
  font-size: 24rpx;
  color: #E5484D;
  background: rgba(229, 72, 77, 0.08);
  padding: 8rpx 24rpx;
  border-radius: 8rpx;
  margin-left: 16rpx;
}

/* ==================== 加载状态 ==================== */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #E9E2D4;
  border-top: 4rpx solid #3A7A5C;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 16rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 24rpx;
  color: #8B958C;
}

/* ==================== 没有更多 ==================== */
.no-more {
  text-align: center;
  padding: 32rpx 0;
}

.no-more-text {
  font-size: 24rpx;
  color: #8B958C;
}