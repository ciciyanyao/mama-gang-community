<view class="container">
  <!-- 顶部搜索 -->
  <view class="search-box">
    <!-- 🚨 原来是 iconify-icon 导致报错，现改为原生写法 -->
    <text style="font-size: 36rpx; color: #999;">🔍</text>
    <input class="search-input" placeholder="搜索案由、城市或关键词..." bindinput="onSearchInput" value="{{keyword}}" />
  </view>

  <!-- 筛选标签 -->
  <scroll-view class="tags-scroll" scroll-x>
    <view class="tags-container">
      <view wx:for="{{types}}" wx:key="index" class="tag {{currentType === item ? 'active' : ''}}" bindtap="switchType" data-type="{{item}}">
        {{item}}
      </view>
    </view>
  </scroll-view>

  <!-- 案例列表 -->
  <view class="case-list" wx:if="{{displayList.length > 0}}">
    <block wx:for="{{displayList}}" wx:key="_id">
      <!-- 🚨 这里绑定了 bindtap 和 data-id -->
      <view class="paper-card" bindtap="goToDetail" data-id="{{item._id}}" style="background-image: url('{{item.bgImage}}');">
        <view class="paper-content">
          <view class="case-title">{{item.title}}</view>
          <view class="case-info">
            <text class="case-city">{{item.city}}</text>
            <text class="case-type">{{item.type}}</text>
          </view>
          <view class="case-summary">{{item.summary}}</view>
        </view>
      </view>
    </block>
  </view>

  <!-- 无数据时的提示 -->
  <view class="empty-state" wx:else>
    <text>暂无相关案例</text>
  </view>
</view>