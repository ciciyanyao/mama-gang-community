<view class="container">
  <!-- 顶部搜索 -->
  <view class="search-box">
    <text style="font-size: 36rpx; color: #8B958C;">🔍</text>
    <input class="search-input" placeholder="搜索案由、城市或关键词..." bindinput="onSearchInput" value="{{keyword}}" />
  </view>

  <!-- 城市筛选 -->
  <scroll-view class="tags-scroll" scroll-x>
    <view class="tags-container">
      <view wx:for="{{cityList}}" wx:key="index" class="tag {{currentCity === item.name ? 'active' : ''}}" bindtap="switchCity" data-name="{{item.name}}">
        {{item.name}}<text wx:if="{{item.count}}">{{item.count}}</text>
      </view>
    </view>
  </scroll-view>

  <!-- 类型筛选 -->
  <scroll-view class="tags-scroll" scroll-x>
    <view class="tags-container">
      <view wx:for="{{types}}" wx:key="index" class="tag {{currentType === item.name ? 'active' : ''}}" bindtap="switchType" data-name="{{item.name}}">
        {{item.name}}<text wx:if="{{item.count}}">{{item.count}}</text>
      </view>
    </view>
  </scroll-view>

  <!-- 计数条 -->
  <view class="count-bar" wx:if="{{filterTotal > 0}}">共{{allCases.length}}条案例，筛选出{{filterTotal}}条（已显示{{totalShown}}条）</view>
  <view class="count-bar" wx:else>共{{allCases.length}}条案例</view>

  <!-- 加载中 -->
  <view class="empty-state" wx:if="{{loading}}">
    <text>案例加载中...</text>
  </view>

  <!-- 案例列表 -->
  <view class="case-list" wx:elif="{{displayList.length > 0}}">
    <block wx:for="{{displayList}}" wx:key="_id">
      <view class="paper-card" bindtap="goToDetail" data-id="{{item._id}}">
        <!-- 背景图用 <image> 组件铺底（CSS background-image 渲染层不稳定，改为组件渲染） -->
        <image class="paper-bg" src="{{item.bgImage}}" mode="aspectFill" lazy-load />
        <view class="paper-content">
          <view class="case-title">
            <text wx:for="{{item.titleHL}}" wx:key="index" class="{{item.hl ? 'hl' : ''}}">{{item.text}}</text>
          </view>
          <view class="case-info">
            <text class="case-city">
              <text wx:for="{{item.cityHL}}" wx:key="index" class="{{item.hl ? 'hl' : ''}}">{{item.text}}</text>
            </text>
            <text class="case-type">
              <text wx:for="{{item.typeHL}}" wx:key="index" class="{{item.hl ? 'hl' : ''}}">{{item.text}}</text>
            </text>
          </view>
          <view class="case-summary">
            <text wx:for="{{item.summaryHL}}" wx:key="index" class="{{item.hl ? 'hl' : ''}}">{{item.text}}</text>
          </view>
        </view>
      </view>
    </block>
  </view>

  <!-- 无数据时的提示 -->
  <view class="empty-state" wx:else>
    <text>暂无相关案例</text>
  </view>
</view>
