page { background-color: #F0EBE1; font-family: sans-serif; }
.container { padding: 20rpx 30rpx; }

/* 搜索框 */
.search-box {
  display: flex; align-items: center;
  background: #ffffff; border-radius: 36rpx;
  padding: 16rpx 30rpx; margin-bottom: 20rpx;
}
.search-input { flex: 1; font-size: 28rpx; margin-left: 16rpx; }

/* 筛选标签 */
.tags-scroll { white-space: nowrap; margin-bottom: 20rpx; }
.tags-container { display: inline-flex; gap: 20rpx; }
.tag {
  background: #ffffff; color: #7C887E;
  padding: 10rpx 30rpx; border-radius: 30rpx; font-size: 26rpx;
}
.tag.active { background: #3A7A5C; color: #ffffff; font-weight: bold; }

/* 手账卡片列表 */
.case-list { display: flex; flex-direction: column; gap: 30rpx; }
.paper-card {
  position: relative;
  width: 100%;
  background-size: 100% 100%; 
  background-repeat: no-repeat;
  background-position: center;
  box-sizing: border-box;
  padding: 80rpx 60rpx; 
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06), 0 16rpx 40rpx rgba(0, 0, 0, 0.05);
}
.paper-content { position: relative; z-index: 2; word-break: break-all; }

.case-title { font-size: 32rpx; font-weight: bold; color: #4A3B32; margin-bottom: 16rpx; line-height: 1.4; text-align: center; }
.case-info { margin-bottom: 16rpx; text-align: center; }
.case-city, .case-type {
  font-size: 22rpx; color: #9C7C5B;
  background: rgba(233, 226, 212, 0.8); padding: 4rpx 16rpx;
  border-radius: 10rpx; margin: 0 8rpx; display: inline-block;
}
.case-summary { font-size: 28rpx; color: #6B5E52; line-height: 1.6; text-align: justify; margin-top: 10rpx; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 4; overflow: hidden; }

.empty-state { display: flex; justify-content: center; align-items: center; padding-top: 100rpx; color: #8B958C; font-size: 28rpx; }