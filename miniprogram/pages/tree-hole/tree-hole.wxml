<view class="container">
  <view class="page-title">树洞</view>
  <view class="placeholder">页面建设中：匿名倾诉（认领类 D）</view>
</view>
<view class="container">
  <!-- 顶部区域 -->
  <view class="header">
    <view class="title">树洞</view>
    <view class="subtitle">完全匿名·不会被认出</view>
    
    <!-- 情绪分类标签 -->
    <scroll-view class="tags-scroll" scroll-x>
      <view class="tags-container">
        <view wx:for="{{tags}}" wx:key="index" class="tag {{currentTag === item ? 'active' : ''}}" bindtap="switchTag" data-tag="{{item}}">
          {{item}}
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 帖子列表 -->
  <view class="post-list">
    <block wx:for="{{postList}}" wx:key="_id">
      <view class="post-card">
        <!-- 右上角角标 -->
        <view class="badge">树洞·匿名</view>
        
        <view class="post-header">
          <view class="avatar">🫥</view>
          <view class="user-info">
            <view class="user-name">匿名妈妈 · {{item.userId}}</view>
            <view class="post-time">{{item.time}}</view>
          </view>
          <view class="mood-tag">{{item.mood}}</view>
        </view>
        
        <view class="post-content">{{item.content}}</view>
        
        <view class="post-footer">
          <view class="hug-count">已有 {{item.hugCount}} 位妈妈抱过你</view>
          <view class="hug-btn" bindtap="handleHug" data-id="{{item._id}}">抱抱你</view>
        </view>
      </view>
    </block>
  </view>

  <!-- 底部固定输入框 -->
  <view class="footer">
    <input class="footer-input" placeholder="说点什么，这里没人认识你…" bindinput="onInput" value="{{moodInput}}" />
    <button class="footer-btn" bindtap="postMood">投进树洞</button>
  </view>
</view>