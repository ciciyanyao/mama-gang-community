/* pages/tree-hole/tree-hole.wxss */
page {
  background-color: #F8F7F4; 
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
}

/* ========== 顶部区域 ========== */
.header {
  position: relative;
  width: 100%;
  /* 不要设置固定高度，让图片把高度撑开 */
}

.header-bg-img {
  width: 100%;
  display: block; /* 消除图片底部的默认间隙 */
}

/* 内容层绝对定位铺在图片上 */
.header-content { 
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  padding: 100rpx 40rpx 60rpx 40rpx; /* 调整内边距让内容居中 */
  display: flex;
  flex-direction: column;
  align-items: center; /* 水平居中 */
  justify-content: center; /* 垂直居中 */
  box-sizing: border-box;
}

.title { 
  font-size: 60rpx; font-weight: bold; color: #4A3B32;
  font-family: "STKaiti", "KaiTi", "楷体", serif; 
  text-shadow: 2rpx 2rpx 0px rgba(255,255,255,0.8), 4rpx 4rpx 0px rgba(0,0,0,0.1);
  letter-spacing: 10rpx; margin-bottom: 10rpx;
}
.subtitle { font-size: 24rpx; color: #7A6A5A; margin-top: 6rpx; letter-spacing: 2rpx; }

/* ========== 帖子列表及卡片 ========== */
.post-list { padding: 20rpx 30rpx; padding-bottom: calc(280rpx + env(safe-area-inset-bottom)); }

/* 卡片容器：靠图片撑开高度，不再设置 min-height */
.post-card {
  position: relative;
  margin-bottom: 40rpx;
  width: 100%;
  border-radius: 20rpx; /* 保持圆角，防止图片直角溢出 */
  overflow: hidden; /* 保证图片不超过卡片圆角 */
}

.card-bg-img {
  width: 100%;
  display: block;
}

/* 🌟 内容绝对定位覆盖在卡片上 */
.card-content {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  /* 内边距是关键，让文字避开边缘的图案，必须大于图片边缘空白区域 */
  padding: 130rpx 100rpx 120rpx 100rpx; 
  display: flex;
  flex-direction: column;
  align-items: center; /* 所有内容水平居中 */
  justify-content: center; /* 垂直居中 */
  box-sizing: border-box;
}

.deco { position: absolute; font-size: 40rpx; z-index: 5; }
.deco-top-left { top: 10rpx; left: 10rpx; }
.deco-bottom-right { bottom: 10rpx; right: 10rpx; }

.post-header { display: flex; align-items: center; justify-content: center; width: 100%; margin-bottom: 20rpx; }
.avatar {
  width: 70rpx; height: 70rpx; background-color: #FFFFFF; border-radius: 50%;
  border: 4rpx solid #A7F3D0; display: flex; align-items: center; justify-content: center;
  font-size: 36rpx; margin-right: 20rpx; flex-shrink: 0;
}
.user-info { display: flex; flex-direction: column; align-items: center; }
.user-name { font-size: 28rpx; font-weight: bold; color: #064E3B; }
.post-time { font-size: 24rpx; color: #6B7280; margin-top: 4rpx; }
.mood-tag {
  background-color: #FFFFFF; color: #EF4444; font-size: 22rpx; padding: 6rpx 16rpx;
  border-radius: 10rpx; border: 2rpx solid #FCA5A5; font-weight: bold; margin-left: 20rpx; flex-shrink: 0;
}

.post-content {
  font-size: 30rpx; color: #064E3B; line-height: 1.6;
  margin-bottom: 20rpx; font-weight: 500; word-break: break-all;
  text-align: center; width: 100%;
}

.post-footer {
  display: flex; justify-content: space-between; align-items: center;
  width: 100%; border-top: 3rpx dashed #A7F3D0; padding-top: 20rpx;
}
.hug-count { font-size: 24rpx; color: #6B7280; font-weight: bold; }
.hug-btn {
  background-color: #FFFFFF; color: #047857; font-size: 24rpx; padding: 10rpx 24rpx;
  border-radius: 255px 15px 225px 15px / 15px 225px 15px 255px;
  border: 4rpx solid #A7F3D0; box-shadow: 3rpx 3rpx 0 #A7F3D0; transition: all 0.1s; font-weight: bold;
}
.hug-btn:active { box-shadow: 1rpx 1rpx 0 #A7F3D0; transform: translate(2rpx, 2rpx); }
.hug-btn.hugged { background-color: #059669; color: #FFFFFF; border-color: #047857; }

/* 底部输入框：固定于自定义 tabBar 上方，高度随内容自适应（最大页面 1/4） */
.footer {
  position: fixed;
  bottom: calc(100rpx + env(safe-area-inset-bottom)); /* 100rpx = custom-tab-bar 高度 */
  left: 0;
  right: 0;
  background: #FFFFFF;
  padding: 20rpx 30rpx;
  border-top: 4rpx solid #A7F3D0;
  display: flex;
  align-items: flex-end; /* textarea 变高时按钮贴底对齐 */
  z-index: 10;
}
.footer-input {
  flex: 1;
  min-height: 76rpx;
  background-color: #E9F7F0; /* 浅青色（参考图风格） */
  border-radius: 24rpx;
  border: 4rpx solid #D1FAE5;
  padding: 18rpx 30rpx;
  font-size: 28rpx;
  margin-right: 20rpx;
  color: #064E3B;
  line-height: 1.5;
  box-sizing: border-box;
}
.footer-placeholder {
  color: #9AA5B1;
}
.footer-btn {
  background-color: #059669; color: #FFFFFF; font-size: 28rpx; padding: 0 40rpx;
  height: 76rpx; line-height: 76rpx; border-radius: 36rpx; margin: 0;
  border: 4rpx solid #047857; box-shadow: 4rpx 4rpx 0 #047857; font-weight: bold;
  flex-shrink: 0;
}
.footer-btn:active { box-shadow: 1rpx 1rpx 0 #047857; transform: translate(3rpx, 3rpx); }
.footer-btn::after { border: none; }