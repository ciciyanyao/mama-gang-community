/* pages/tree-hole/tree-hole.wxss */
page {
  background-color: #F8F7F4; 
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
}

/* ========== 顶部区域 ========== */
.header { position: relative; width: 100%; }
.header-bg-img { width: 100%; display: block; }
.header-content { 
  position: absolute; top: 0; left: 0; width: 100%; height: 100%;
  padding: 80rpx 40rpx 40rpx 40rpx;
  display: flex; flex-direction: column; align-items: center; justify-content: center; box-sizing: border-box;
}
.title { font-size: 60rpx; font-weight: bold; color: #4A3B32; font-family: "STKaiti", "KaiTi", "楷体", serif; text-shadow: 2rpx 2rpx 0px rgba(255,255,255,0.8), 4rpx 4rpx 0px rgba(0,0,0,0.1); letter-spacing: 10rpx; margin-bottom: 10rpx; }
.subtitle { font-size: 24rpx; color: #7A6A5A; margin-top: 6rpx; letter-spacing: 2rpx; }
.tags-scroll { white-space: nowrap; margin-top: 20rpx; width: 100%; text-align: center; }
.tags-container { display: inline-flex; gap: 20rpx; }
.tag { background-color: rgba(255, 255, 255, 0.8); color: #6B5B4D; padding: 12rpx 32rpx; border-radius: 30rpx; font-size: 26rpx; border: 2rpx solid #D3C7B8; }
.tag.active { background-color: #059669; color: #FFFFFF; font-weight: bold; border: 2rpx solid #047857; }

/* ========== 帖子列表及卡片 ========== */
/* 底部留出距离，防止最后一条帖子被输入框遮挡 */
.post-list { padding: 20rpx 30rpx 250rpx 30rpx; }
.post-card { position: relative; margin-bottom: 40rpx; width: 100%; border-radius: 20rpx; overflow: hidden; }
.card-bg-img { width: 100%; display: block; }
.card-content { position: absolute; top: 0; left: 0; width: 100%; height: 100%; padding: 130rpx 100rpx 120rpx 100rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; box-sizing: border-box; }
.deco { position: absolute; font-size: 40rpx; z-index: 5; }
.deco-top-left { top: 10rpx; left: 10rpx; }
.deco-bottom-right { bottom: 10rpx; right: 10rpx; }
.post-header { display: flex; align-items: center; justify-content: center; width: 100%; margin-bottom: 20rpx; }
.avatar { width: 70rpx; height: 70rpx; background-color: #FFFFFF; border-radius: 50%; border: 4rpx solid #A7F3D0; display: flex; align-items: center; justify-content: center; font-size: 36rpx; margin-right: 20rpx; flex-shrink: 0; }
.user-info { display: flex; flex-direction: column; align-items: center; }
.user-name { font-size: 28rpx; font-weight: bold; color: #064E3B; }
.post-time { font-size: 24rpx; color: #6B7280; margin-top: 4rpx; }
.mood-tag { background-color: #FFFFFF; color: #EF4444; font-size: 22rpx; padding: 6rpx 16rpx; border-radius: 10rpx; border: 2rpx solid #FCA5A5; font-weight: bold; margin-left: 20rpx; flex-shrink: 0; }
.post-content { font-size: 30rpx; color: #064E3B; line-height: 1.6; margin-bottom: 20rpx; font-weight: 500; word-break: break-all; text-align: center; width: 100%; }
.post-footer { display: flex; justify-content: space-between; align-items: center; width: 100%; border-top: 3rpx dashed #A7F3D0; padding-top: 20rpx; }
.hug-count { font-size: 24rpx; color: #6B7280; font-weight: bold; }
.hug-btn { background-color: #FFFFFF; color: #047857; font-size: 24rpx; padding: 10rpx 24rpx; border-radius: 255px 15px 225px 15px / 15px 225px 15px 255px; border: 4rpx solid #A7F3D0; box-shadow: 3rpx 3rpx 0 #A7F3D0; transition: all 0.1s; font-weight: bold; }
.hug-btn:active { box-shadow: 1rpx 1rpx 0 #A7F3D0; transform: translate(2rpx, 2rpx); }
.hug-btn.hugged { background-color: #059669; color: #FFFFFF; border-color: #047857; }

/* ========== 🌟 底部输入框：紧贴 TabBar 正上方 ========== */
.footer {
  position: fixed; 
  left: 0; 
  right: 0; 
  /* 核心：使用 calc 精准定位在原生 TabBar (100rpx) 之上，同时加入安全区适配 */
  bottom: calc(100rpx + env(safe-area-inset-bottom)); 
  background: #FFFFFF; 
  padding: 20rpx 30rpx;
  /* 顶部一条细细的边框，完美融入页面 */
  border-top: 2rpx solid #E8F5E9; 
  display: flex; 
  align-items: center;
  z-index: 9999;
  box-shadow: 0 -4rpx 12rpx rgba(0,0,0,0.03); /* 极淡的阴影，增加层次 */
}
.footer-input {
  flex: 1; 
  background-color: #F8F7F4; 
  border-radius: 36rpx; 
  border: 2rpx solid #D1FAE5;
  padding: 18rpx 30rpx; 
  font-size: 28rpx; 
  margin-right: 20rpx; 
  color: #064E3B;
}
.footer-btn {
  background-color: #059669; 
  color: #FFFFFF; 
  font-size: 28rpx; 
  padding: 0 40rpx;
  height: 72rpx; 
  line-height: 72rpx; 
  border-radius: 36rpx; 
  margin: 0;
  border: none; /* 去掉之前复杂的边框和阴影，看起来更干净 */
  font-weight: bold;
}
.footer-btn:active { opacity: 0.8; }
.footer-btn::after { border: none; }