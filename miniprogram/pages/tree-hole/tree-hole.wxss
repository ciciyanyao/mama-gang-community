/* pages/tree-hole/tree-hole.wxss */
page {
  background-color: #f5f7fa; /* 浅灰底色 */
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
}

/* 顶部区域 */
.header {
  background-color: #059669; /* 深绿色背景 */
  padding: 40rpx 30rpx 30rpx;
  color: #ffffff;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
}

.subtitle {
  font-size: 24rpx;
  opacity: 0.8;
  margin-top: 10rpx;
}

/* 情绪分类标签 */
.tags-scroll {
  white-space: nowrap;
  margin-top: 30rpx;
}

.tags-container {
  display: inline-flex;
  gap: 20rpx;
}

.tag {
  background-color: rgba(255, 255, 255, 0.2);
  color: #ffffff;
  padding: 10rpx 30rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  transition: all 0.3s;
}

.tag.active {
  background-color: #ffffff;
  color: #059669;
  font-weight: bold;
}

/* 帖子列表 */
.post-list {
  padding: 20rpx 30rpx;
  padding-bottom: 150rpx; /* 防止底部输入框遮挡内容 */
}

.post-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  position: relative;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.03);
}

/* 右上角角标 */
.badge {
  position: absolute;
  top: 0;
  right: 0;
  background-color: #e6f7f3;
  color: #059669;
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 0 20rpx 0 20rpx;
}

.post-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.avatar {
  width: 70rpx;
  height: 70rpx;
  background-color: #f0f0f0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 20rpx;
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.post-time {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.mood-tag {
  background-color: #fef2f2;
  color: #ef4444;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 10rpx;
}

.post-content {
  font-size: 30rpx;
  color: #444;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.post-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1rpx solid #f0f0f0;
  padding-top: 20rpx;
}

.hug-count {
  font-size: 24rpx;
  color: #999;
}

.hug-btn {
  background-color: #ecfdf5;
  color: #059669;
  font-size: 24rpx;
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
}

/* 底部固定输入框 */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  padding: 20rpx 30rpx;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.05);
  display: flex;
  align-items: center;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.footer-input {
  flex: 1;
  background-color: #f5f7fa;
  border-radius: 36rpx;
  padding: 20rpx 30rpx;
  font-size: 28rpx;
  margin-right: 20rpx;
}

.footer-btn {
  background-color: #059669;
  color: #ffffff;
  font-size: 28rpx;
  padding: 0 40rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
  margin: 0;
}

.footer-btn::after {
  border: none;
}