/* pages/jobs/jobs.wxss —— 招聘信息样式 */

.page-wrap {
  min-height: 100vh;
  background: #F7F3EA;
  padding-bottom: 40rpx;
}

/* ==================== 城市筛选 ==================== */
.city-tabs {
  background: #FFFFFF;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0EDE5;
  position: sticky;
  top: 0;
  z-index: 10;
}

.city-scroll {
  white-space: nowrap;
  padding: 0 24rpx;
}

.city-tab {
  display: inline-block;
  padding: 12rpx 32rpx;
  margin-right: 16rpx;
  border-radius: 32rpx;
  background: #F0EDE5;
  transition: all 0.2s;
}

.city-tab.active {
  background: #2E7D5B;
}

.city-text {
  font-size: 26rpx;
  color: #666;
}

.city-tab.active .city-text {
  color: #FFFFFF;
  font-weight: 500;
}

/* ==================== 空状态 ==================== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0 0;
}

.empty-icon-wrap {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: rgba(46, 125, 91, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.empty-emoji {
  font-size: 72rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #C0C0C0;
}

/* ==================== 职位卡片列表 ==================== */
.job-list {
  padding: 20rpx 24rpx;
}

.job-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* 顶部：标题 + 薪资 */
.job-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.job-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
  margin-right: 16rpx;
}

.job-salary {
  font-size: 30rpx;
  font-weight: bold;
  color: #E5484D;
  flex-shrink: 0;
}

/* 公司信息 */
.job-company {
  margin-bottom: 16rpx;
}

.company-name {
  font-size: 26rpx;
  color: #777;
}

/* 详情行 */
.job-details {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.detail-item {
  display: flex;
  align-items: center;
}

.detail-icon {
  font-size: 24rpx;
  margin-right: 6rpx;
}

.detail-text {
  font-size: 24rpx;
  color: #888;
}

/* 标签 */
.job-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  background: rgba(46, 125, 91, 0.08);
}

.tag-text {
  font-size: 22rpx;
  color: #2E7D5B;
}

/* ==================== 没有更多 ==================== */
.no-more {
  text-align: center;
  padding: 32rpx 0;
}

.no-more-text {
  font-size: 24rpx;
  color: #C0C0C0;
}