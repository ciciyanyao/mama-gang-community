<!-- pages/jobs/jobs.wxml —— 招聘信息（F6） -->
<view class="page-wrap">

  <!-- ==================== 城市筛选 Tabs ==================== -->
  <view class="city-tabs">
    <scroll-view scroll-x class="city-scroll">
      <view
        class="city-tab {{activeCity === index ? 'active' : ''}}"
        wx:for="{{cities}}"
        wx:key="*this"
        bindtap="onCityTap"
        data-index="{{index}}"
      >
        <text class="city-text">{{item}}</text>
      </view>
    </scroll-view>
  </view>

  <!-- ==================== 空状态 ==================== -->
  <view class="empty-state" wx:if="{{isEmpty}}">
    <view class="empty-icon-wrap">
      <text class="empty-emoji">💼</text>
    </view>
    <text class="empty-text">暂无招聘信息</text>
    <text class="empty-hint">该城市暂无岗位，请切换城市查看</text>
  </view>

  <!-- ==================== 职位卡片列表 ==================== -->
  <view class="job-list" wx:if="{{!isEmpty}}">
    <view
      class="job-card"
      wx:for="{{displayJobs}}"
      wx:key="_id"
      bindtap="onJobTap"
      data-id="{{item._id}}"
    >
      <!-- 顶部：标题 + 薪资 -->
      <view class="job-top">
        <text class="job-title">{{item.title}}</text>
        <text class="job-salary">{{item.salary}}</text>
      </view>

      <!-- 公司信息 -->
      <view class="job-company">
        <text class="company-name">{{item.company}}</text>
      </view>

      <!-- 详情行 -->
      <view class="job-details">
        <view class="detail-item">
          <text class="detail-icon">📍</text>
          <text class="detail-text">{{item.city}} {{item.district}}</text>
        </view>
        <view class="detail-item">
          <text class="detail-icon">🕐</text>
          <text class="detail-text">{{item.workHours}}</text>
        </view>
        <view class="detail-item">
          <text class="detail-icon">📋</text>
          <text class="detail-text">{{item.jobType}}</text>
        </view>
      </view>

      <!-- 标签 -->
      <view class="job-tags">
        <view class="tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">
          <text class="tag-text">{{tag}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 没有更多 -->
  <view class="no-more" wx:if="{{noMore && displayJobs.length > 0}}">
    <text class="no-more-text">— 没有更多岗位了 —</text>
  </view>
</view>