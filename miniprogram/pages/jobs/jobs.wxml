<view class="container">
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title">妈妈岗招聘</text>
    <text class="page-subtitle">为您推荐适合宝妈的弹性工作岗位</text>
  </view>

  <!-- 城市筛选 -->
  <scroll-view class="filter-scroll" scroll-x="true">
    <view class="filter-list">
      <view
        class="filter-item {{currentCity === item ? 'active' : ''}}"
        wx:for="{{cities}}"
        wx:key="*this"
        bindtap="onCityChange"
        data-city="{{item}}"
      >
        <text class="filter-text">{{item}}</text>
      </view>
    </view>
  </scroll-view>

  <!-- 类型筛选 -->
  <scroll-view class="filter-scroll" scroll-x="true">
    <view class="filter-list">
      <view
        class="filter-item type-item {{currentType === item ? 'active' : ''}}"
        wx:for="{{jobTypes}}"
        wx:key="*this"
        bindtap="onTypeChange"
        data-type="{{item}}"
      >
        <text class="filter-text">{{item}}</text>
      </view>
    </view>
  </scroll-view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{jobs.length === 0 && !loading}}">
    <text class="empty-icon">💼</text>
    <text class="empty-text">暂无符合条件的岗位</text>
    <text class="empty-hint">试试切换其他城市或类型筛选</text>
  </view>

  <!-- 岗位列表 -->
  <view class="job-list" wx:else>
    <view
      class="job-card"
      wx:for="{{jobs}}"
      wx:key="_id"
      bindtap="onJobTap"
      data-job-id="{{item._id}}"
    >
      <view class="job-header">
        <text class="job-title">{{item.title}}</text>
        <text class="job-salary">{{item.salary}}</text>
      </view>

      <view class="job-info">
        <view class="info-item">
          <text class="info-icon">🏢</text>
          <text class="info-text">{{item.company || '企业信息'}}</text>
        </view>
        <view class="info-item">
          <text class="info-icon">📍</text>
          <text class="info-text">{{item.location || item.city}}</text>
        </view>
        <view class="info-item">
          <text class="info-icon">⏰</text>
          <text class="info-text">{{item.work_hours || '灵活安排'}}</text>
        </view>
      </view>

      <view class="job-footer">
        <view class="job-tags">
          <text class="tag type-tag">{{item.type || '弹性'}}</text>
          <text class="tag city-tag" wx:if="{{item.city}}">{{item.city}}</text>
        </view>
        <text class="job-time">{{item._timeText}}</text>
      </view>
    </view>
  </view>

  <!-- 加载状态 -->
  <view class="loading-wrap" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 没有更多 -->
  <view class="no-more" wx:if="{{!hasMore && jobs.length > 0}}">
    <text class="no-more-text">— 没有更多岗位了 —</text>
  </view>
</view>