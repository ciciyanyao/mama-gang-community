<!-- pages/message/message.wxml —— 消息页（小红书式结构：评论/赞/系统通知 + 今天/更早分组） -->
<view class="page-message">
  <!-- 顶部标题 -->
  <view class="page-header">
    <text class="page-title">消息</text>
  </view>

  <!-- 消息类型 Tab 栏（参考小红书：评论/赞/系统通知） -->
  <view class="msg-tab-bar">
    <view
      class="msg-tab-item {{currentTab === index ? 'active' : ''}}"
      wx:for="{{msgTabs}}"
      wx:key="key"
      data-index="{{index}}"
      bindtap="onTapTab"
    >
      <text class="msg-tab-text">{{item.name}}</text>
      <view wx:if="{{currentTab === index}}" class="msg-tab-indicator"></view>
    </view>
  </view>

  <!-- 消息列表区域 -->
  <view class="msg-list-wrap">
    <!-- 首次加载中 -->
    <loading wx:if="{{loading && !loaded}}" text="加载中..." />

    <!-- 评论消息 -->
    <block wx:if="{{msgTabs[currentTab].key === 'comment'}}">
      <!-- 今天 -->
      <view wx:if="{{messages.comment.today.length > 0}}" class="msg-group">
        <view class="msg-group-title">今天</view>
        <view
          class="msg-item {{item.isRead ? '' : 'unread'}}"
          wx:for="{{messages.comment.today}}"
          wx:key="id"
          data-postid="{{item.postId}}"
          bindtap="onTapMessage"
        >
          <view class="msg-item-left">
            <view class="msg-avatar-wrap">
              <image class="msg-avatar" src="{{item.avatar || '/images/user-3-line.svg'}}" mode="aspectFill" />
            </view>
            <view class="msg-dot" wx:if="{{!item.isRead}}"></view>
          </view>
          <view class="msg-item-body">
            <view class="msg-item-header">
              <text class="msg-user-name">{{item.name}}</text>
              <text class="msg-action">{{item.action}}</text>
            </view>
            <text class="msg-comment-content">{{item.content}}</text>
            <view class="msg-post-ref" wx:if="{{item.postTitle}}">
              <text class="msg-post-ref-text">📝 {{item.postTitle}}</text>
            </view>
            <text class="msg-time">{{item.timeText}}</text>
          </view>
        </view>
      </view>

      <!-- 更早 -->
      <view wx:if="{{messages.comment.earlier.length > 0}}" class="msg-group">
        <view class="msg-group-title">更早</view>
        <view
          class="msg-item {{item.isRead ? '' : 'unread'}}"
          wx:for="{{messages.comment.earlier}}"
          wx:key="id"
          data-postid="{{item.postId}}"
          bindtap="onTapMessage"
        >
          <view class="msg-item-left">
            <view class="msg-avatar-wrap">
              <image class="msg-avatar" src="{{item.avatar || '/images/user-3-line.svg'}}" mode="aspectFill" />
            </view>
            <view class="msg-dot" wx:if="{{!item.isRead}}"></view>
          </view>
          <view class="msg-item-body">
            <view class="msg-item-header">
              <text class="msg-user-name">{{item.name}}</text>
              <text class="msg-action">{{item.action}}</text>
            </view>
            <text class="msg-comment-content">{{item.content}}</text>
            <view class="msg-post-ref" wx:if="{{item.postTitle}}">
              <text class="msg-post-ref-text">📝 {{item.postTitle}}</text>
            </view>
            <text class="msg-time">{{item.timeText}}</text>
          </view>
        </view>
      </view>

      <!-- 空状态 -->
      <empty-state
        wx:if="{{!loading && messages.comment.today.length === 0 && messages.comment.earlier.length === 0}}"
        icon="💬"
        text="暂无评论消息"
      />
    </block>

    <!-- 点赞消息 -->
    <block wx:if="{{msgTabs[currentTab].key === 'like'}}">
      <view wx:if="{{messages.like.today.length > 0}}" class="msg-group">
        <view class="msg-group-title">今天</view>
        <view
          class="msg-item {{item.isRead ? '' : 'unread'}}"
          wx:for="{{messages.like.today}}"
          wx:key="id"
          data-postid="{{item.postId}}"
          bindtap="onTapMessage"
        >
          <view class="msg-item-left">
            <view class="msg-avatar-wrap">
              <image class="msg-avatar" src="{{item.avatar || '/images/user-3-line.svg'}}" mode="aspectFill" />
            </view>
            <view class="msg-dot" wx:if="{{!item.isRead}}"></view>
          </view>
          <view class="msg-item-body">
            <view class="msg-item-header">
              <text class="msg-user-name">{{item.name}}</text>
              <text class="msg-action">{{item.action}}</text>
            </view>
            <view class="msg-post-ref" wx:if="{{item.postTitle}}">
              <text class="msg-post-ref-text">📝 {{item.postTitle}}</text>
            </view>
            <text class="msg-time">{{item.timeText}}</text>
          </view>
          <view class="msg-like-icon">♥</view>
        </view>
      </view>

      <view wx:if="{{messages.like.earlier.length > 0}}" class="msg-group">
        <view class="msg-group-title">更早</view>
        <view
          class="msg-item {{item.isRead ? '' : 'unread'}}"
          wx:for="{{messages.like.earlier}}"
          wx:key="id"
          data-postid="{{item.postId}}"
          bindtap="onTapMessage"
        >
          <view class="msg-item-left">
            <view class="msg-avatar-wrap">
              <image class="msg-avatar" src="{{item.avatar || '/images/user-3-line.svg'}}" mode="aspectFill" />
            </view>
          </view>
          <view class="msg-item-body">
            <view class="msg-item-header">
              <text class="msg-user-name">{{item.name}}</text>
              <text class="msg-action">{{item.action}}</text>
            </view>
            <view class="msg-post-ref" wx:if="{{item.postTitle}}">
              <text class="msg-post-ref-text">📝 {{item.postTitle}}</text>
            </view>
            <text class="msg-time">{{item.timeText}}</text>
          </view>
          <view class="msg-like-icon">♥</view>
        </view>
      </view>

      <empty-state
        wx:if="{{!loading && messages.like.today.length === 0 && messages.like.earlier.length === 0}}"
        icon="❤️"
        text="暂无点赞消息"
      />
    </block>

    <!-- 系统通知 -->
    <block wx:if="{{msgTabs[currentTab].key === 'system'}}">
      <empty-state
        wx:if="{{!loading}}"
        icon="🔔"
        text="暂无系统通知"
      />
    </block>
  </view>
</view>
