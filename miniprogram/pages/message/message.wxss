/* pages/message/message.wxss —— 消息页样式（小红书式结构，压缩包版） */

/* 顶部标题 */
.page-header {
  padding: 24rpx 32rpx 0;
  background: #F7F3EA;
}

.page-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #222222;
}

/* 消息类型 Tab 栏 */
.msg-tab-bar {
  display: flex;
  padding: 20rpx 32rpx 0;
  background: #F7F3EA;
  border-bottom: 1rpx solid #EEEEEE;
}

.msg-tab-item {
  position: relative;
  padding: 16rpx 32rpx 20rpx;
  margin-right: 16rpx;
}

.msg-tab-text {
  font-size: 30rpx;
  color: #666666;
  font-weight: 500;
}

.msg-tab-item.active .msg-tab-text {
  color: #222222;
  font-weight: 700;
}

.msg-tab-indicator {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: #2E7D5B;
}

/* 消息列表区域 */
.msg-list-wrap {
  padding: 0 24rpx;
  background: #F7F3EA;
  min-height: 70vh;
}

/* 消息分组 */
.msg-group {
  margin-bottom: 16rpx;
}

.msg-group-title {
  font-size: 24rpx;
  color: #999999;
  padding: 20rpx 8rpx 12rpx;
  font-weight: 500;
}

/* 消息条目 */
.msg-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 20rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  margin-bottom: 12rpx;
  position: relative;
}

.msg-item.unread {
  background: #FFFBF5;
}

/* 左侧头像 */
.msg-item-left {
  position: relative;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.msg-avatar-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #F0F0F0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.msg-avatar {
  width: 80rpx;
  height: 80rpx;
}

/* 未读红点 */
.msg-dot {
  position: absolute;
  top: 0;
  right: 0;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #E5484D;
  border: 2rpx solid #FFFFFF;
}

/* 消息内容区 */
.msg-item-body {
  flex: 1;
  overflow: hidden;
}

.msg-item-header {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
  flex-wrap: wrap;
}

.msg-user-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-right: 8rpx;
}

.msg-action {
  font-size: 26rpx;
  color: #888888;
}

.msg-comment-content {
  display: block;
  font-size: 28rpx;
  color: #444444;
  line-height: 1.5;
  margin-bottom: 8rpx;
}

/* 帖子引用 */
.msg-post-ref {
  display: inline-block;
  background: #F5F5F5;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  margin-bottom: 8rpx;
}

.msg-post-ref-text {
  font-size: 24rpx;
  color: #888888;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: block;
  max-width: 480rpx;
}

.msg-time {
  display: block;
  font-size: 22rpx;
  color: #BBBBBB;
}

/* 点赞图标 */
.msg-like-icon {
  color: #E5484D;
  font-size: 32rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
  align-self: center;
}
