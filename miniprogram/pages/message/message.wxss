/* pages/message/message.wxss —— 消息页（小红书式：三组件入口 + 私信列表）
   色板对齐全局方案：底 #F8F3E8 / 主绿 #3A7A5C / 文字 #2E3A33 #66736A #8B958C / 警示 #E54848 */

/* ==================== 主视图 ==================== */
.page-message {
  min-height: 100vh;
  background: #F8F3E8;
}

.page-header {
  padding: 24rpx 32rpx 8rpx;
}

.page-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #2E3A33;
}

.msg-scroll {
  padding: 8rpx 24rpx 48rpx;
}

/* 三组件入口卡片 */
.inbox-row {
  display: flex;
  margin: 16rpx 0 8rpx;
}

.inbox-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 0 24rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  margin: 0 10rpx;
  box-shadow: 0 2rpx 8rpx rgba(46, 58, 51, 0.05);
}

.inbox-card:first-child {
  margin-left: 0;
}

.inbox-card:last-child {
  margin-right: 0;
}

.inbox-card:active {
  opacity: 0.8;
}

.inbox-icon-wrap {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #F0F4EF;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.inbox-icon {
  width: 44rpx;
  height: 44rpx;
  display: block;
}

.inbox-badge {
  position: absolute;
  top: -10rpx;
  right: -14rpx;
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 8rpx;
  border-radius: 17rpx;
  background: #E54848;
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 34rpx;
  text-align: center;
  box-sizing: border-box;
}

.inbox-label {
  font-size: 26rpx;
  color: #2E3A33;
  font-weight: 500;
}

/* 私信分区标题 */
.section-title {
  font-size: 26rpx;
  color: #8B958C;
  font-weight: 500;
  padding: 24rpx 8rpx 12rpx;
}

/* 私信行 */
.chat-row {
  display: flex;
  align-items: center;
  padding: 24rpx 20rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  margin-bottom: 12rpx;
}

.chat-row:active {
  opacity: 0.8;
}

.chat-avatar-wrap {
  position: relative;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.chat-avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: #E9E2D4;
}

.chat-unread-dot {
  position: absolute;
  top: 0;
  right: 0;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #E54848;
  border: 3rpx solid #FFFFFF;
}

.chat-body {
  flex: 1;
  overflow: hidden;
}

.chat-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6rpx;
}

.chat-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #2E3A33;
}

.chat-time {
  font-size: 22rpx;
  color: #8B958C;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.chat-preview {
  display: block;
  font-size: 26rpx;
  color: #66736A;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ==================== 子列表视图通用 ==================== */
.sub-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx 16rpx;
}

.sub-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #2E3A33;
  margin-left: -16rpx;
}

.sub-back:active {
  opacity: 0.6;
}

.sub-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #2E3A33;
}

.sub-placeholder {
  width: 64rpx;
  height: 64rpx;
}

.msg-list-wrap {
  padding: 0 24rpx 48rpx;
  min-height: 70vh;
}

/* ==================== 消息条目（子列表共用） ==================== */
.msg-group {
  margin-bottom: 16rpx;
}

.msg-group-title {
  font-size: 24rpx;
  color: #8B958C;
  padding: 20rpx 8rpx 12rpx;
  font-weight: 500;
}

.msg-group-title-text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: block;
  max-width: 620rpx;
}

.msg-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 20rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  margin-bottom: 12rpx;
}

.msg-item.unread {
  background: #FBF5EB;
}

.msg-item:active {
  opacity: 0.8;
}

/* 左侧头像 */
.msg-item-left {
  position: relative;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.msg-avatar-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #E9E2D4;
}

.msg-avatar {
  width: 80rpx;
  height: 80rpx;
}

/* 未读红点 */
.msg-dot {
  position: absolute;
  top: 0;
  right: 0;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #E54848;
  border: 2rpx solid #FFFFFF;
}

/* 消息内容区 */
.msg-item-body {
  flex: 1;
  overflow: hidden;
}

.msg-item-header {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
  flex-wrap: wrap;
}

.msg-user-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #2E3A33;
  margin-right: 8rpx;
}

.msg-action {
  font-size: 26rpx;
  color: #8B958C;
}

.msg-comment-content {
  display: block;
  font-size: 28rpx;
  color: #66736A;
  line-height: 1.5;
  margin-bottom: 8rpx;
}

/* 帖子引用 */
.msg-post-ref {
  display: inline-block;
  background: #F0F4EF;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  margin-bottom: 8rpx;
  max-width: 100%;
  box-sizing: border-box;
}

.msg-post-ref-text {
  font-size: 24rpx;
  color: #3A7A5C;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: block;
}

.msg-time {
  display: block;
  font-size: 22rpx;
  color: #8B958C;
}

/* 点赞/收藏图标 */
.msg-like-icon {
  color: #E54848;
  font-size: 32rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
  align-self: center;
}
