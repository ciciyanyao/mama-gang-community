<!-- pages/index/index.wxml —— 论坛首页（B6 热门榜 + B7 置顶帖） -->
<view class="container">

  <!-- ==================== 分类 Tab 栏 ==================== -->
  <scroll-view class="category-bar" scroll-x enable-flex>
    <view
      class="category-item {{activeCategory === index ? 'active' : ''}}"
      wx:for="{{categories}}"
      wx:key="*this"
      data-index="{{index}}"
      bindtap="onCategoryTap"
    >{{item}}</view>
  </scroll-view>

  <!-- ==================== B6 热门榜（横向滚动） ==================== -->
  <view class="hot-section" wx:if="{{hotPosts.length > 0}}">
    <view class="section-header">
      <text class="section-title">🔥 热门榜</text>
    </view>
    <scroll-view class="hot-scroll" scroll-x enable-flex>
      <view
        class="hot-card"
        wx:for="{{hotPosts}}"
        wx:key="_id"
        data-id="{{item._id}}"
        bindtap="onHotTap"
      >
        <view class="hot-rank rank-{{item.rank <= 3 ? item.rank : 'normal'}}">{{item.rank}}</view>
        <view class="hot-title">{{item.title}}</view>
        <view class="hot-stats">
          <text class="hot-stat">👍 {{item.likes || 0}}</text>
          <text class="hot-stat">💬 {{item.comment_count || 0}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- ==================== 帖子列表 ==================== -->
  <view class="post-section">
    <view class="section-header">
      <text class="section-title">最新帖子</text>
    </view>

    <!-- 首次加载中（列表为空时居中显示） -->
    <view class="loading-wrap" wx:if="{{loading && postList.length === 0}}">
      <view class="loading-spinner"></view>
      <text class="loading-text">加载中...</text>
    </view>

    <!-- 帖子卡片 -->
    <view
      class="post-card"
      wx:for="{{postList}}"
      wx:key="_id"
      data-id="{{item._id}}"
      bindtap="onPostTap"
    >
      <!-- 置顶标签 -->
      <view class="top-tag" wx:if="{{item.is_top}}">置顶</view>

      <!-- 用户信息行 -->
      <view class="post-header">
        <image class="post-avatar" src="{{item.avatar || '/images/default-avatar.svg'}}" mode="aspectFill" />
        <view class="post-user-info">
          <text class="post-nickname">{{item.nickname || '匿名用户'}}</text>
          <text class="post-time">{{item.timeText}}</text>
        </view>
        <view class="post-category-tag" wx:if="{{item.category}}">{{item.category}}</view>
      </view>

      <!-- 帖子标题 -->
      <view class="post-title" wx:if="{{item.title}}">{{item.title}}</view>

      <!-- 内容预览 -->
      <view class="post-content" wx:if="{{item.contentPreview}}">
        {{item.contentPreview}}{{item.content.length > 80 ? '...' : ''}}
      </view>

      <!-- 图片预览（最多显示 3 张） -->
      <view class="post-images" wx:if="{{item.images && item.images.length > 0}}">
        <image
          class="post-image"
          wx:for="{{item.images}}"
          wx:for-item="img"
          wx:for-index="imgIdx"
          wx:key="imgIdx"
          wx:if="{{imgIdx < 3}}"
          src="{{img}}"
          mode="aspectFill"
        />
      </view>

      <!-- 底部统计 -->
      <view class="post-footer">
        <view class="post-stat">
          <text class="stat-icon">👍</text>
          <text class="stat-num">{{item.likes || 0}}</text>
        </view>
        <view class="post-stat">
          <text class="stat-icon">💬</text>
          <text class="stat-num">{{item.comment_count || 0}}</text>
        </view>
      </view>
    </view>

    <!-- 加载状态 -->
    <view class="loading-more" wx:if="{{loading}}">
      <view class="loading-spinner"></view>
      <text class="loading-text">加载中...</text>
    </view>

    <!-- 没有更多 -->
    <view class="no-more" wx:if="{{noMore && postList.length > 0}}">
      <text class="no-more-text">— 已经到底啦 —</text>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{isEmpty && !loading}}">
      <image class="empty-icon" src="/images/empty-box.svg" mode="aspectFit" />
      <text class="empty-text">暂无帖子</text>
      <text class="empty-hint">快去发第一篇帖子吧~</text>
    </view>
  </view>
</view>