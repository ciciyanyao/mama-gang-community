/* pages/index/index.wxss —— 论坛首页样式（融合版：压缩包 UI 样式） */

.page-index {
  min-height: 100vh;
  background: #F7F3EA;
  padding-bottom: 40rpx;
}

/* 顶部标题 */
.page-header {
  padding: 24rpx 32rpx 0;
  background: #F7F3EA;
}

.page-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #222222;
}

/* 板块分类 Tab */
.category-bar {
  white-space: nowrap;
  padding: 20rpx 24rpx 16rpx;
  background: #F7F3EA;
}

.category-item {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  font-size: 26rpx;
  color: #666666;
  background: #FFFFFF;
  border-radius: 28rpx;
  transition: all 0.2s ease;
}

.category-item.active {
  background: #2E7D5B;
  color: #FFFFFF;
  font-weight: 600;
}

/* ===== 热门榜（日历撕页效果）===== */
.hot-section {
  padding: 16rpx 24rpx;
}

.hot-header {
  display: flex;
  align-items: baseline;
  margin-bottom: 16rpx;
}

.hot-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #222222;
}

.hot-subtitle {
  font-size: 24rpx;
  color: #999999;
  margin-left: 12rpx;
}

/* 日历卡片外观 */
.hot-calendar-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  position: relative;
}

/* 日历顶部装饰条（模仿日历挂钩） */
.calendar-top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 24rpx;
  background: linear-gradient(135deg, #E8845C 0%, #E07A3F 100%);
}

.calendar-hole {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.4);
  border: 2rpx solid rgba(255, 255, 255, 0.6);
}

.calendar-line {
  flex: 1;
  height: 4rpx;
  background: rgba(255, 255, 255, 0.3);
  margin: 0 16rpx;
  border-radius: 2rpx;
}

/* 撕页边缘效果 */
.hot-calendar-card::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: repeating-linear-gradient(
    90deg,
    transparent,
    transparent 8rpx,
    #F0EDE6 8rpx,
    #F0EDE6 10rpx
  );
}

/* swiper 容器 */
.hot-swiper {
  height: 120rpx;
}

/* 单条热门帖 */
.hot-item {
  display: flex;
  align-items: center;
  padding: 20rpx 28rpx;
  height: 120rpx;
  box-sizing: border-box;
}

.hot-rank {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #E8845C 0%, #E07A3F 100%);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.hot-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  overflow: hidden;
}

.hot-post-title {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 6rpx;
}

.hot-heat {
  font-size: 22rpx;
  color: #E07A3F;
}

/* ===== 功能宫格 ===== */
.grid-section {
  display: flex;
  justify-content: space-around;
  padding: 24rpx 24rpx 16rpx;
  margin: 0 24rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.grid-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 0;
}

.grid-icon {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  background: linear-gradient(135deg, #F0F8F4 0%, #E8F5EE 100%);
  border-radius: 20rpx;
  margin-bottom: 10rpx;
}

.grid-name {
  font-size: 24rpx;
  color: #555555;
}

/* ===== 帖子信息流 ===== */
.post-section {
  padding: 16rpx 24rpx 24rpx;
}

.section-header {
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #222222;
}

.post-list {
  /* post-card 组件自带卡片样式，这里控制间距 */
}

/* 触底加载中与空态间距 */
.post-section loading {
  margin: 24rpx 0;
}

.no-more {
  text-align: center;
  padding: 32rpx 0;
  font-size: 24rpx;
  color: #CCCCCC;
}
