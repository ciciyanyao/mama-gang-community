<!-- pages/mine/mine.wxml —— 我的页（F3） -->
<view class="page-wrap">

  <!-- ==================== 用户信息区域 ==================== -->
  <view class="user-section">
    <!-- 已登录 -->
    <view class="user-info" wx:if="{{hasUserInfo && userInfo}}">
      <image
        class="user-avatar"
        src="{{userInfo.avatarUrl || '/images/user-3-line.svg'}}"
        mode="aspectFill"
      />
      <view class="user-detail">
        <text class="user-name">{{userInfo.nickName || '妈妈岗用户'}}</text>
        <text class="user-subtitle">妈妈岗社区成员</text>
      </view>
    </view>

    <!-- 未登录 -->
    <view class="user-info" wx:else>
      <view class="avatar-placeholder">
        <image class="avatar-placeholder-icon" src="/images/user-3-line.svg" mode="aspectFit" />
      </view>
      <view class="user-detail">
        <text class="user-name login-prompt" bindtap="onLoginTap">点击登录</text>
        <text class="user-subtitle">登录后享受更多功能</text>
      </view>
    </view>
  </view>

  <!-- ==================== 菜单列表 ==================== -->
  <view class="menu-section">
    <view
      class="menu-item"
      wx:for="{{menuList}}"
      wx:key="id"
      bindtap="onMenuTap"
      data-url="{{item.url}}"
      data-id="{{item.id}}"
      data-adminonly="{{item.adminOnly}}"
      wx:if="{{!item.adminOnly || isAdmin}}"
    >
      <view class="menu-icon-wrap">
        <text class="menu-emoji">{{item.icon}}</text>
      </view>
      <text class="menu-title">{{item.title}}</text>
      <view class="menu-arrow">
        <text class="arrow-symbol">›</text>
      </view>
    </view>
  </view>

  <!-- ==================== 退出登录 ==================== -->
  <view class="logout-section" wx:if="{{hasUserInfo}}">
    <view class="logout-btn" bindtap="onLogout">
      <text class="logout-text">退出登录</text>
    </view>
  </view>

  <!-- ==================== 版本信息 ==================== -->
  <view class="version-info">
    <text class="version-text">妈妈岗社区 v1.0.0</text>
  </view>

  <!-- ==================== 登录弹窗 ==================== -->
  <login-modal id="loginModal" bind:success="onLoginSuccess" />
</view>