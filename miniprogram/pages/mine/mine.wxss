/* pages/mine/mine.wxss —— 我的页样式 */

.page-wrap {
  min-height: 100vh;
  background: #F7F3EA;
}

/* ==================== 用户信息区域 ==================== */
.user-section {
  background: linear-gradient(135deg, #2E7D5B 0%, #3A9D72 100%);
  padding: 80rpx 40rpx 60rpx;
  border-radius: 0 0 32rpx 32rpx;
}

.user-info {
  display: flex;
  align-items: center;
}

.user-avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.4);
  margin-right: 32rpx;
  background: rgba(255, 255, 255, 0.15);
}

.avatar-placeholder {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 32rpx;
}

.avatar-placeholder-icon {
  width: 64rpx;
  height: 64rpx;
  opacity: 0.7;
}

.user-detail {
  flex: 1;
}

.user-name {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.login-prompt {
  opacity: 0.9;
}

.user-subtitle {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.75);
}

/* ==================== 菜单列表 ==================== */
.menu-section {
  margin: 32rpx 24rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx 28rpx;
  position: relative;
}

.menu-item::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 96rpx;
  right: 28rpx;
  height: 1rpx;
  background: #F0EDE5;
}

.menu-item:last-child::after {
  display: none;
}

.menu-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.menu-emoji {
  font-size: 36rpx;
}

.menu-title {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.menu-arrow {
  flex-shrink: 0;
}

.arrow-symbol {
  font-size: 36rpx;
  color: #CCC;
  line-height: 1;
}

/* ==================== 退出登录 ==================== */
.logout-section {
  margin: 40rpx 24rpx 0;
}

.logout-btn {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx 0;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.logout-text {
  font-size: 30rpx;
  color: #E5484D;
}

/* ==================== 版本信息 ==================== */
.version-info {
  text-align: center;
  padding: 48rpx 0 120rpx;
}

.version-text {
  font-size: 22rpx;
  color: #C0C0C0;
}