<!-- pages/post-detail/post-detail.wxml —— 帖子详情页 -->
<view class="page-wrap">

  <!-- ==================== 加载占位 ==================== -->
  <view class="loading-wrap" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- ==================== 帖子内容 ==================== -->
  <view class="post-body" wx:if="{{post && !loading}}">

    <!-- 用户信息 -->
    <view class="detail-header">
      <image class="detail-avatar" src="{{post.authorAvatar || '/images/default-avatar.svg'}}" mode="aspectFill" />
      <view class="detail-user-info">
        <text class="detail-nickname">{{post.authorName || '宝妈用户'}}</text>
        <text class="detail-time">{{post.timeText}}</text>
      </view>
    </view>

    <!-- 标题 -->
    <view class="detail-title">{{post.title}}</view>

    <!-- 正文 -->
    <view class="detail-content">{{post.content}}</view>

    <!-- 图片 -->
    <view class="detail-images" wx:if="{{post.images && post.images.length > 0}}">
      <image
        class="detail-image"
        wx:for="{{post.images}}"
        wx:key="*this"
        src="{{item}}"
        mode="widthFix"
        data-src="{{item}}"
        bindtap="onImagePreview"
      />
    </view>

    <!-- 统计栏 -->
    <view class="detail-stats">
      <view class="stat-item {{isLiked ? 'liked' : ''}}" bindtap="onLikeTap">
        <text class="stat-icon">{{isLiked ? '❤️' : '🤍'}}</text>
        <text class="stat-text">{{likeCount}}</text>
      </view>
      <view class="stat-item">
        <text class="stat-icon">💬</text>
        <text class="stat-text">{{commentCount}}</text>
      </view>
      <view class="stat-item {{isFavorited ? 'favorited' : ''}}" bindtap="onFavoriteTap">
        <text class="stat-icon">{{isFavorited ? '⭐' : '☆'}}</text>
        <text class="stat-text">{{isFavorited ? '已收藏' : '收藏'}}</text>
      </view>
    </view>
  </view>

  <!-- ==================== 评论列表 ==================== -->
  <view class="comment-section" wx:if="{{post && !loading}}">
    <view class="comment-header">
      <text class="comment-title">评论 ({{commentCount}})</text>
    </view>

    <!-- 评论加载中 -->
    <view class="comment-loading" wx:if="{{commentLoading}}">
      <view class="loading-spinner small"></view>
      <text class="loading-text">加载评论中...</text>
    </view>

    <!-- 评论列表 -->
    <view class="comment-list" wx:if="{{comments.length > 0}}">
      <view class="comment-item" wx:for="{{comments}}" wx:key="_id">
        <image class="comment-avatar" src="{{item.authorAvatar || '/images/default-avatar.svg'}}" mode="aspectFill" />
        <view class="comment-body">
          <view class="comment-meta">
            <text class="comment-nickname">{{item.authorName || '宝妈用户'}}</text>
            <text class="comment-time">{{item.timeText}}</text>
          </view>

          <!-- 回复标注 -->
          <view class="reply-hint" wx:if="{{item.reply_nickname}}">
            回复 <text class="reply-name">{{item.reply_nickname}}</text>
          </view>

          <view class="comment-content">{{item.content}}</view>

          <view class="comment-actions">
            <view
              class="reply-btn"
              data-commentid="{{item._id}}"
              data-nickname="{{item.authorName || '宝妈用户'}}"
              bindtap="onReplyTap"
            >回复</view>
          </view>
        </view>
      </view>
    </view>

    <!-- 空评论 -->
    <view class="comment-empty" wx:if="{{!commentLoading && comments.length === 0}}">
      <text class="comment-empty-text">暂无评论，快来抢沙发~</text>
    </view>
  </view>

  <!-- 底部占位（避免被输入框遮挡） -->
  <view class="bottom-placeholder"></view>
</view>

<!-- ==================== 底部评论输入栏 ==================== -->
<view class="input-bar {{inputFocused ? 'focused' : ''}}" wx:if="{{post}}">
  <!-- 回复提示 -->
  <view class="reply-bar" wx:if="{{replyTo}}">
    <text class="reply-bar-text">回复 {{replyTo.nickname}}</text>
    <view class="reply-bar-cancel" bindtap="onCancelReply">取消</view>
  </view>

  <view class="input-row">
    <input
      class="comment-input"
      placeholder="{{replyTo ? '回复 ' + replyTo.nickname + '...' : '写评论...'}}"
      value="{{commentText}}"
      bindinput="onCommentInput"
      bindfocus="onCommentFocus"
      bindblur="onCommentBlur"
      confirm-type="send"
      bindconfirm="onSubmitComment"
    />
    <view class="send-btn {{commentText ? 'active' : ''}}" bindtap="onSubmitComment">发送</view>
  </view>
</view>

<!-- ==================== 登录弹窗 ==================== -->
<login-modal id="loginModal" bind:success="onLoginSuccess" />